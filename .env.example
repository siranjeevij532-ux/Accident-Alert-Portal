# Copy to .env (never commit it)
SENDER_EMAIL=your-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
RECEIVER_EMAIL=who-gets-alerts@gmail.com
WEATHER_API_KEY=your-openweathermap-key
YOLO_MODEL=yolo11n.pt   # smaller/faster model, good for live camera on CPU
VEHICLE_CONF=0.35       # detection confidence (raise to 0.5 for fewer false detections)
ALERT_WEBHOOK=          # optional: URL that receives a JSON POST when an accident is confirmed
